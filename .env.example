# Copy this file to .env for local development.
# Never commit the real .env file — it is already in .gitignore.
# In GitHub Actions, these are provided via repository Secrets instead.

# ---- Required secrets ----
GEMINI_API_KEY=your-gemini-api-key-here
EMAIL_ADDRESS=yourname@gmail.com
EMAIL_PASSWORD=your-16-char-gmail-app-password
RECIPIENT_EMAIL=yourname@gmail.com

# ---- Optional settings (defaults shown) ----
TIMEZONE=Asia/Kolkata
LANGUAGE=gu
GEMINI_MODEL=gemini-2.5-flash

# Describes your company/services to the AI so it can prioritize stories that
# suggest a concrete new product/service you could pitch to clients, and fill
# in a per-story "business_angle_gu" suggestion. Edit this to match your
# actual services/industries - see README section "Tailoring to your business".
# COMPANY_CONTEXT=Ninja Technolabs, an IT/software services company that builds for clients across many industries: web & mobile app development, AI/ML integration, e-commerce solutions, cloud development, business process automation, and CRM integration.

# How far back (hours) to look for new articles each run
LOOKBACK_HOURS=24

# Cost / safety limits — see README "Cost Protection" section
MAX_ARTICLES_TO_PROCESS=40
MAX_STORIES=10
MAX_AI_REQUESTS=5
